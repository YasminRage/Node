<h2>Users Table</h2>
<table class="table">
  <thead>
    <tr>
      <th>Name</th>
      <th>Email</th>
      <th>Zip Code</th>
    </tr>
  </thead>
  <tbody>
    <% users.forEach(user => { %>
      <tr>
        <a href="<%= `/user/${user._id}` %>"></a>
        <td><%= user.fullName %></td>
        <td><%= user.email %></td>
        <td><%= user.postcode %></td>
      </tr>
    <% }); %>
  </tbody>
</table>