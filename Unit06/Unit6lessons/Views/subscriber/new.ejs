<div class="data-form">
  <form action="/subscriber/create" method="POST">
    <h2>Add a new subscriber</h2>
    <label for="inputName">Name</label>
    <input type="text" name="name" id="inputName" placeholder="Name" required>

    <label for="inputEmail">Email address</label>
    <input type="email" name="email" id="inputEmail" placeholder="Email address" required>

    <label for="inputPostcode">Postcode</label>
    <input type="text" name="postcode" id="inputPostcode" placeholder="Post Code" required>

    <button type="submit">Add Subscriber</button>
  </form>
</div>