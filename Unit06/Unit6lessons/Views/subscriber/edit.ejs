<div class="data-form">
  <form method="POST" action="<%= `/subscriber/${subscriber._id}/update?_method=PUT` %>">
    <h2>Edit subscriber</h2>
    <label for="inputName">Name</label>
    <input type="text" name="name" id="inputName" value="<%= subscriber.name %>" required>

    <label for="inputEmail">Email address</label>
    <input type="email" name="email" id="inputEmail" value="<%= subscriber.email %>" required>

    <label for="inputPostcode">Postcode</label>
    <input type="text" name="postcode" id="inputPostcode" value="<%= subscriber.postcode %>" required>

    <button type="submit">Update Subscriber</button>
  </form>
</div>