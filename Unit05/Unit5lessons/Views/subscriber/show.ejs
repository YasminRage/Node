<h1><%= subscriber.name %></h1>
<table class="bakery-table">
  <tr><th>Email</th><td><%= subscriber.email %></td></tr>
  <tr><th>Postcode</th><td><%= subscriber.postcode %></td></tr>
</table>

<div><a href="/subscriber">View all subscribers</a></div>
<div><a href="<%= `/subscriber/${subscriber._id}/edit` %>">Edit Subscriber</a></div>
<div>
  <a href="<%= `/subscriber/${subscriber._id}/delete?_method=DELETE` %>"
     onclick="return confirm('Are you sure you want to delete this subscriber?')">Delete</a>
</div>